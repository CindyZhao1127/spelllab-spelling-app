# WorkBuddy 工作区数据（非项目文件）
.workbuddy/

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器 / 临时文件
.vscode/
# JetBrains IDE：提交项目级配置，忽略个人状态文件（workspace.xml 等）
.idea/*
!.idea/.gitignore
!.idea/misc.xml
!.idea/modules.xml
!.idea/*.iml
!.idea/vcs.xml
!.idea/runConfigurations/
!.idea/codeStyles/
!.idea/inspectionProfiles/
*.swp
*.tmp
*.log

# Python 桌面版：运行时数据与打包产物
__pycache__/
*.py[cod]
desktop/data/
desktop/build/
desktop/dist/
*.spec
.venv/
venv/
